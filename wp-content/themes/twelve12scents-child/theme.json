{
    "version": 3,
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "settings": {
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "'Cormorant Garamond', Georgia, serif",
                    "name": "Cormorant Garamond",
                    "slug": "cormorant-garamond",
                    "fontFace": [
                        {
                            "fontFamily": "Cormorant Garamond",
                            "fontWeight": "400 700",
                            "fontStyle": "normal",
                            "src": [
                                "https://fonts.gstatic.com/s/cormorantgaramond/v21/co3YmX5slCNuHLi8bLeY9MK7whWMhyjornFLsS6V7w.woff2"
                            ]
                        }
                    ]
                },
                {
                    "fontFamily": "'Manrope', system-ui, sans-serif",
                    "name": "Manrope",
                    "slug": "manrope",
                    "fontFace": [
                        {
                            "fontFamily": "Manrope",
                            "fontWeight": "300 700",
                            "fontStyle": "normal",
                            "src": [
                                "https://fonts.gstatic.com/s/manrope/v15/xn7_YHE41ni1AdIRqAuZuw1Bx9mbZk79FO_F87jxeN7B.woff2"
                            ]
                        }
                    ]
                }
            ]
        },
        "color": {
            "palette": [
                {"slug": "ts-bg", "name": "Background", "color": "#F4EFE7"},
                {"slug": "ts-nav", "name": "Nav Dark", "color": "#221C15"},
                {"slug": "ts-ink", "name": "Ink", "color": "#26221C"},
                {"slug": "ts-accent", "name": "Accent Gold", "color": "#A9822F"},
                {"slug": "ts-accent-lt", "name": "Accent Light", "color": "#CBA85B"},
                {"slug": "ts-muted", "name": "Muted", "color": "#5C5246"},
                {"slug": "ts-on-dark", "name": "On Dark", "color": "#F1ECE1"},
                {"slug": "ts-border", "name": "Border", "color": "#EAE3D6"},
                {"slug": "page-background", "name": "Page Background", "color": "#F4EFE7"},
                {"slug": "page-text", "name": "Page Text", "color": "#26221C"},
                {"slug": "light", "name": "Light", "color": "#F1ECE1"}
            ]
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "color": {
            "background": "#F4EFE7",
            "text": "#26221C"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--manrope)",
            "fontSize": "16px",
            "lineHeight": "1.7"
        },
        "elements": {
            "link": {"color": {"text": "#A9822F"}},
            "h1": {"typography": {"fontFamily": "var(--wp--preset--font-family--cormorant-garamond)", "fontWeight": "600"}},
            "h2": {"typography": {"fontFamily": "var(--wp--preset--font-family--cormorant-garamond)", "fontWeight": "600"}},
            "h3": {"typography": {"fontFamily": "var(--wp--preset--font-family--cormorant-garamond)", "fontWeight": "600"}},
            "h4": {"typography": {"fontFamily": "var(--wp--preset--font-family--manrope)", "fontWeight": "700"}}
        },
        "blocks": {
            "core/navigation": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--manrope)",
                    "fontWeight": "600",
                    "fontSize": "13px"
                },
                "elements": {
                    "link": {
                        "color": {"text": "#F1ECE1"},
                        ":hover": {"color": {"text": "#A9822F"}}
                    }
                }
            }
        }
    }
}
